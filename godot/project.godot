; Everlinth — cliente Godot 4 (ver docs/migracion-godot.md).
; El servidor Node (server/) sigue siendo la autoridad; este proyecto solo pinta,
; recoge la entrada y reproduce el sonido.

config_version=5

[application]

config/name="Everlinth"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Config="*res://scripts/config.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
