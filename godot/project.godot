; Everlinth — cliente Godot 4 (ver docs/migracion-godot.md).
; El servidor Node (server/) sigue siendo la autoridad; este proyecto solo pinta,
; recoge la entrada y reproduce el sonido.

config_version=5

[application]

config/name="Everlinth"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Config="*res://scripts/config.gd"
Net="*res://scripts/net/net.gd"
Catalog="*res://scripts/assets/catalog.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[shader_globals]

win_glow={
"type": "float",
"value": 0.0
}
win_lit={
"type": "float",
"value": 0.3
}

cut_params={
"type": "vec4",
"value": Vector4(0, 0, 0, 1)
}
cut_cam_fwd={
"type": "vec3",
"value": Vector3(0, 0, 1)
}
cut_keep={
"type": "float",
"value": 0.18
}
sprite_light={
"type": "float",
"value": 1.0
}
sprite_flash={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
fac_albedo={
"type": "sampler2DArray",
"value": ""
}
fac_normal={
"type": "sampler2DArray",
"value": ""
}
fac_rough={
"type": "sampler2DArray",
"value": ""
}
facade_on={
"type": "float",
"value": 0.0
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
