{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "everlinth-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=server"],
      "port": 3000
    },
    {
      "name": "everlinth-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace=client", "--", "--port", "5173", "--strictPort"],
      "port": 5173,
      "autoPort": false
    }
  ]
}
